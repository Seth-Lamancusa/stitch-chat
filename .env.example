OPENAI_API_KEY=
# Optional — OpenRouter / Ollama / any OpenAI-compatible base URL
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=gpt-4o-mini

# Cursor local SDK adapter (runtimes/cursor + bridge shim)
CURSOR_API_KEY=

# Shared Dart + Python log level: TRACE | DEBUG | INFO | WARNING | ERROR
STITCH_LOG_LEVEL=DEBUG
# Optional — defaults to <projectRoot>/logs (dart.log + python.log, 10MB x5)
# STITCH_LOG_DIR=logs

# Cloud API — unset = https://api.stitch.fyi (production). Set only for local backend:
# STITCH_API_URL=http://localhost:8081

# Visual typing-indicator fixtures — seeds a short branch + honors
# [[mockTyping:author,…]] markers on those messages as sticky chrome:
# STITCH_MOCK_TYPING_CUES=1

# Reply-visible + unrevealed stitch-sibling fixture column (sibling arrows /
# Surgical Loading UX). Seeds T→A1 (reply, shown) with T⇢S1… (stitch, not
# auto-followed):
# STITCH_MOCK_STITCH_SIBLING=1

# Hidden-reply fixture columns (Reveal hidden thread + sibling-nav race):
# STITCH_MOCK_HIDDEN_REPLY=1
